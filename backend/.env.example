# Runtime mode: auto, true, or false.
# auto: use Live Mode only when all required external
# services are configured; otherwise use Demo Mode.
# true: always use clearly labeled sample data.
# false: use Live Mode and report missing services
# as unavailable without stopping the application.
DEMO_MODE=auto

# Live Mode backend configuration.
# These values may remain empty in Demo Mode.
# Example:
# postgresql+psycopg2://user:password@localhost:5432/database_name
DATABASE_URL=
TOMTOM_API_KEY=

# Optional local language model integration.
# Leave OLLAMA_BASE_URL empty to use the built-in
# deterministic analysis explanation immediately.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=8

# Live point analysis request timeouts.
OVERPASS_REQUEST_TIMEOUT_SECONDS=20
OVERPASS_CONNECT_TIMEOUT_SECONDS=8
OVERPASS_QUERY_TIMEOUT_SECONDS=18
TOMTOM_REQUEST_TIMEOUT_SECONDS=10

# Optional Copernicus Sentinel-2 context analysis.
# Leave both credentials empty to disable the feature.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CATALOG_URL=https://sh.dataspace.copernicus.eu/catalog/v1/search
COPERNICUS_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
COPERNICUS_STATISTICAL_URL=https://sh.dataspace.copernicus.eu/statistics/v1
SATELLITE_MAX_CLOUD_COVER=20
SATELLITE_SEARCH_DAYS=90
SATELLITE_CACHE_TTL_SECONDS=21600
SATELLITE_REQUEST_TIMEOUT_SECONDS=30

# Google Earth Engine Dynamic World classification.
# Keep the service-account JSON outside Git.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
DYNAMIC_WORLD_DATASET=GOOGLE/DYNAMICWORLD/V1
DYNAMIC_WORLD_SEARCH_DAYS=30
DYNAMIC_WORLD_MAX_PIXELS=5000000
DYNAMIC_WORLD_REQUEST_TIMEOUT_SECONDS=30
